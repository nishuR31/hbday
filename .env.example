# Server Port
PORT=4000

# Gmail SMTP Configuration for sending real emails
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL=yourgmail@gmail.com
PASS=your_16_char_app_password

# Upstash Redis & BullMQ Queue Configuration (Supports rediss:// and redis://)
REDIS_URL=rediss://default:your_token@your-host.upstash.io:6379

# PostgreSQL / Supabase Database Configuration
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/hbday

# Anti-Spam Rate Limits for Adding Birthdays (Defaults: 5 daily, 15 weekly per IP)
DAILY_ADD_LIMIT=5
WEEKLY_ADD_LIMIT=15

# If EMAIL/PASS, REDIS_URL, or DATABASE_URL are not provided, HBday operates with persistent local JSON mirrors & simulation safely without errors.
